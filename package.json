{
  "name": "职业教育专业智能决策系统",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "dev:full": "concurrently -k -n WEB,API -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:all": "node scripts/start-dev-all.mjs",
    "build": "vite build",
    "build:api": "npm --prefix server run build",
    "build:all": "npm run build && npm run build:api",
    "db:migrate": "npm --prefix server run migrate",
    "db:seed": "npm --prefix server run seed",
    "preview": "vite preview",
    "build-css": "npx tailwindcss -i ./src/input.css -o ./dist/output.css",
    "watch-css": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/echarts": "^4.9.22",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "echarts": "^6.0.0",
    "lucide-react": "^1.62.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.7.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
